# Production env template — copy to infra/prod/.env and fill EVERY value.
# Never commit a filled .env.

# Public hostnames this deployment answers (comma-separated). Include the DNS
# name the school types in the browser.
ALLOWED_HOSTS=school.example.com,localhost

# One campus UUID for this deployment. Generate once and keep forever.
SCHOOL_ID=

# Postgres
POSTGRES_USER=school
POSTGRES_PASSWORD=
POSTGRES_DB=school_prod

# Django / Fernet
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=

# Private object storage (MinIO on this compose stack)
OBJECT_STORAGE_BUCKET=school-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Host port published for HTTP (put TLS terminator / Certbot in front in VPS)
HOST_HTTP_PORT=80

# Optional tuning
GUNICORN_WORKERS=3

# First owner bootstrap (used by: docker compose exec api python backend/manage.py bootstrap_owner)
OWNER_LOGIN=
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=School Owner

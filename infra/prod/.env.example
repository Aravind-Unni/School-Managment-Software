# Production env — copy to infra/prod/.env and fill EVERY blank value.
# Never commit a filled .env. Generate secrets with: python3 infra/prod/make-env.py

# The hostname parents and staff type, e.g. school.example.in. Caddy gets a
# free TLS certificate for it automatically (ports 80 and 443 must be open).
DOMAIN=
ALLOWED_HOSTS=

# One campus UUID for this deployment. Generate once and keep forever.
SCHOOL_ID=

# Postgres
POSTGRES_USER=school
POSTGRES_PASSWORD=
POSTGRES_DB=school_prod

# Django session signing and the 2FA secret encryption key (Fernet)
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=

# Private object storage (MinIO on this compose stack)
OBJECT_STORAGE_BUCKET=school-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Published ports (Caddy)
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443

# Backups: days to keep, and the UTC hour of the nightly run (20 = 01:30 IST)
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=20

# Optional tuning
GUNICORN_WORKERS=3

# Optional: only these account ids may manage backups (comma-separated)
PLATFORM_OPS_ACTOR_IDS=

# First owner (used once by: ... exec api python backend/manage.py bootstrap_owner)
OWNER_LOGIN=
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=School Owner

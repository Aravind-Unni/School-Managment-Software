# TLS front door when the school is reached by IP address (no domain name).
# Public certificate authorities do not issue for bare IPs, so Caddy uses its
# own local certificate: browsers show a warning once; accept it to continue.
# Select with CADDYFILE=Caddyfile.ip and DOMAIN=<the server's IP> in .env.

{
	# Browsers send no server name when given an IP; answer with the IP's certificate.
	default_sni {$DOMAIN}
	# The public ports may not be 80/443, so redirect explicitly below.
	auto_https disable_redirects
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}:{$PUBLIC_HTTPS_PORT}{uri} permanent
}

https://{$DOMAIN} {
	tls internal
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
	reverse_proxy web:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}

{
  "name": "school-platform-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React/TypeScript frontend. One module's feature routes are served per standalone profile.",
  "engines": {
    "node": "^22.22.2 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --reporter=default --reporter=json --outputFile=../dev/state/frontend-vitest.json",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "generate:client": "openapi-typescript ../contracts/M00/openapi.yaml -o src/features/demo/generated/schema.d.ts && openapi-typescript ../contracts/M01/openapi.yaml -o src/features/access/generated/schema.d.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "@testing-library/user-event": "14.6.1"
  }
}

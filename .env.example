# ============================================================================
# B00 configuration contract -- NAMES AND DOCUMENTATION ONLY.
#
# This file is committed. It MUST NOT contain a real value, not even a
# development one. `scripts/dev.py up` generates dev/secrets/<worktree>.<ID>.env
# outside Git with locally generated secrets.
#
# Scoping: every service URL and credential is per-profile AND per-module, so
# two developers on two worktrees never share a database, queue or bucket.
# ============================================================================

# Deployment profile. One of: standalone | integrated | production
# `standalone` installs exactly one business app plus the harness.
# `production` refuses fake adapters, test personas and demo fixtures.
APP_ENV=

# Target module id, M00..M14. M00 is the placeholder demo app.
# In standalone mode this selects the single Django app added to
# INSTALLED_APPS and the only resources Compose starts.
MODULE_ID=

# UUID of the school tenant this deployment serves. One campus per
# deployment; reuse for another school means a separate deployment,
# database and storage credentials.
SCHOOL_ID=

# PostgreSQL DSN. Database name is namespaced <developer>_<worktree>_<module>
# so simultaneous standalone profiles are isolated.
DATABASE_URL=

# Broker URL for the worker. Only set for modules that declare
# scheduled_jobs or own asynchronous work; otherwise leave empty and no
# broker container is started.
BROKER_URL=

# S3-compatible private object storage. Never public-read.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Django session signing secret. Generated per environment, never shared
# between profiles, never reused across schools.
SESSION_SECRET=

# Fernet key used to encrypt TOTP seeds at rest (M01 access).
# Rotating this requires re-enrolment; see docs/modules/M01.
TOTP_ENCRYPTION_KEY=

# Development persona mode. One of: off | fixed
# `fixed` derives ONE synthetic persona SERVER-SIDE and is refused unless the
# request arrives on localhost and APP_ENV != production. Client-supplied
# school, role or relationship headers are never honoured in any mode.
DEV_PERSONA_MODE=

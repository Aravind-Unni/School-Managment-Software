{
  "openapi": "3.1.0",
  "info": {
    "title": "M10 Alumni Records and Contact Permissions",
    "version": "1.0.0",
    "description": "Paths relative to /api/v1. Candidates, directory, contact preferences, exports. No social network or fundraising. Closed write schemas. No editable grade history."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/alumni/candidates": {
      "get": {
        "operationId": "list_alumni_candidates",
        "summary": "Pending graduate/leaver candidates with minimal school history",
        "x-permission": "alumni.review",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "excluded"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateCollection"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/alumni/candidates/{id}/approve": {
      "post": {
        "operationId": "approve_alumni_candidate",
        "summary": "Include as AlumniProfile or exclude candidate",
        "x-permission": "alumni.review",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveCandidateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile when include=true, candidate when include=false",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApproveCandidateResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/alumni": {
      "get": {
        "operationId": "list_alumni",
        "summary": "Scoped paginated alumni directory",
        "x-permission": "alumni.read",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "graduate",
                "transfer"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlumniCollection"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/alumni/{id}/contact": {
      "patch": {
        "operationId": "patch_alumni_contact",
        "summary": "Update contact fields and preferences",
        "x-permission": "alumni.manage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchContactRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlumniProfileDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/alumni/exports": {
      "post": {
        "operationId": "create_alumni_export",
        "summary": "Authorized export job (granted fields only)",
        "x-permission": "alumni.export",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExportRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportJobDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    },
    "schemas": {
      "CandidateCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/AlumniCandidateDTO"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AlumniCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/AlumniProfileDTO"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AlumniCandidateDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "school_id",
          "student_id",
          "leaving_event_id",
          "outcome",
          "state",
          "version",
          "admission_no",
          "display_name",
          "last_standard",
          "leaving_year"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "school_id": {
            "type": "string",
            "format": "uuid"
          },
          "student_id": {
            "type": "string",
            "format": "uuid"
          },
          "leaving_event_id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "$ref": "#/$defs/LeavingOutcome"
          },
          "state": {
            "$ref": "#/$defs/CandidateState"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "admission_no": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "last_standard": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "leaving_year": {
            "type": "integer",
            "minimum": 1900
          }
        }
      },
      "AlumniProfileDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "school_id",
          "student_id",
          "last_standard",
          "leaving_year",
          "outcome",
          "snapshot_version",
          "contact_fields",
          "preferences",
          "version",
          "display_name",
          "admission_no"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "school_id": {
            "type": "string",
            "format": "uuid"
          },
          "student_id": {
            "type": "string",
            "format": "uuid"
          },
          "last_standard": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "leaving_year": {
            "type": "integer",
            "minimum": 1900
          },
          "outcome": {
            "$ref": "#/$defs/LeavingOutcome"
          },
          "snapshot_version": {
            "type": "integer",
            "minimum": 1
          },
          "contact_fields": {
            "$ref": "#/$defs/ContactFields"
          },
          "preferences": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ContactPreferenceDTO"
            }
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "admission_no": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ApproveCandidateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "include",
          "reason"
        ],
        "properties": {
          "include": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "contact_policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fields": {
                "$ref": "#/$defs/ContactFields"
              },
              "preferences": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "purpose",
                    "channel",
                    "allowed"
                  ],
                  "properties": {
                    "purpose": {
                      "$ref": "#/$defs/ContactPurpose"
                    },
                    "channel": {
                      "$ref": "#/$defs/ContactChannel"
                    },
                    "allowed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ApproveCandidateResponse": {
        "oneOf": [
          {
            "$ref": "#/$defs/AlumniProfileDTO"
          },
          {
            "$ref": "#/$defs/AlumniCandidateDTO"
          }
        ]
      },
      "PatchContactRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "reason"
        ],
        "properties": {
          "fields": {
            "$ref": "#/$defs/ContactFields"
          },
          "preferences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "purpose",
                "channel",
                "allowed"
              ],
              "properties": {
                "purpose": {
                  "$ref": "#/$defs/ContactPurpose"
                },
                "channel": {
                  "$ref": "#/$defs/ContactChannel"
                },
                "allowed": {
                  "type": "boolean"
                }
              }
            }
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "CreateExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filters",
          "fields"
        ],
        "properties": {
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "year": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1900
              },
              "outcome": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "graduate",
                  "transfer",
                  null
                ]
              }
            }
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "display_name",
                "admission_no",
                "leaving_year",
                "outcome",
                "email",
                "phone",
                "postal_address"
              ]
            }
          }
        }
      },
      "ExportJobDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "state"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Frozen error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../common/error-envelope.schema.json"
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school/common/scope-facts",
  "title": "ScopeFacts",
  "description": "Inputs to an authorisation decision. Server-internal: never serialised to a browser. RelationshipFacts is a SEPARATE type returned by Registry, which the host scope resolver folds in; this split is what prevents a recursive Access to Registry call.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_school_id"],
  "properties": {
    "resource_school_id": { "type": "string", "format": "uuid" },
    "subject_person_id": { "type": ["string", "null"], "format": "uuid" },
    "section_id": { "type": ["string", "null"], "format": "uuid" },
    "subject_id": { "type": ["string", "null"], "format": "uuid" },
    "relationship": {
      "type": ["string", "null"],
      "enum": ["none", "self", "guardian", "assigned_teacher", "class_teacher", null]
    },
    "effective_date": { "type": ["string", "null"], "format": "date" }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "M12 Compressed Answer Sheet Evidence and Private Files",
    "version": "1.0.0",
    "description": "Paths relative to /api/v1. Upload quarantine, compression candidates, quality confirmation, private reads, retention. Closed write schemas."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/uploads": {
      "post": {
        "operationId": "begin_upload",
        "summary": "Open a scoped upload session",
        "x-permission": "files.upload",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BeginUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadSessionDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/uploads/{id}/complete": {
      "post": {
        "operationId": "complete_upload",
        "summary": "Verify quarantine bytes and enqueue processing",
        "x-permission": "files.upload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created file in processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteUploadResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/files/{id}/status": {
      "get": {
        "operationId": "get_file_status",
        "summary": "File state and candidate metadata",
        "x-permission": "files.upload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/files/{id}/quality-confirmation": {
      "post": {
        "operationId": "confirm_file_quality",
        "summary": "Teacher confirms candidate readability",
        "x-permission": "files.review_quality",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QualityConfirmationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted immutable canonical",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/files/{id}/reprocess": {
      "post": {
        "operationId": "reprocess_file",
        "summary": "Enqueue higher-fidelity candidate; never rewrite pinned versions",
        "x-permission": "files.review_quality",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReprocessRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/files/{id}/retention-hold": {
      "post": {
        "operationId": "set_retention_hold",
        "summary": "Set or clear legal hold (recent 2FA)",
        "x-permission": "files.retention.manage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetentionHoldRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "schemas": {
      "BeginUploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "client_name",
          "declared_bytes",
          "mime"
        ],
        "properties": {
          "purpose": {
            "$ref": "#/$defs/FilePurpose"
          },
          "client_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "declared_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "mime": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "UploadSessionDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "upload_url",
          "expires_at",
          "max_bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "upload_url": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CompleteUploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_sha256"
        ],
        "properties": {
          "source_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "CompleteUploadResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "state"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "const": "processing"
          }
        }
      },
      "FileDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "school_id",
          "state",
          "review_confirmed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "school_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "#/$defs/FileState"
          },
          "canonical_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 64,
            "maxLength": 64
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "profile_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_confirmed": {
            "type": "boolean"
          },
          "rejection_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "QualityConfirmationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_version",
          "readability_confirmed"
        ],
        "properties": {
          "candidate_version": {
            "type": "integer",
            "minimum": 1
          },
          "readability_confirmed": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "ReprocessRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "reason"
        ],
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "higher_fidelity"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "RetentionHoldRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "legal_hold",
          "expected_version"
        ],
        "properties": {
          "legal_hold": {
            "type": "boolean"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "FileEvidenceRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "version",
          "sha256"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "ReadUrlDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "read_url",
          "expires_at"
        ],
        "properties": {
          "read_url": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ArtifactRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "version",
          "sha256",
          "mime"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "mime": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "PurgeJobDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "blocked",
              "completed",
              "failed"
            ]
          },
          "block_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}

    },
    {
      "status": 409,
      "code": "version_conflict",
      "message_key": "error.version_conflict",
      "when": "expected_version mismatch on publish."
    },
    {
      "status": 409,
      "code": "state_conflict",
      "message_key": "communications.error.notice_not_draft",
      "when": "Publish called when notice is not draft."
    },
    {
      "status": 409,
      "code": "state_conflict",
      "message_key": "communications.error.dedupe_payload_mismatch",

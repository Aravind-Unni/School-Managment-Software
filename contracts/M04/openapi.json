    "/attendance/students/{id}/record": {
      "get": {
        "operationId": "get_attendance_record",
        "summary": "A pupil's attendance by subject and by month (default: current term to date)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Totals, per subject and per month.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "student_id",
                    "from_date",
                    "to_date",
                    "total",
                    "by_subject",
                    "by_month"
                  ],
                  "properties": {
                    "student_id": {
                      "type": "string"
                    },
                    "from_date": {
                      "type": "string"
                    },
                    "to_date": {
                      "type": "string"
                    },
                    "total": {
                      "type": "object",
                      "properties": {
                        "due": {
                          "type": "integer"
                        },
                        "marked": {
                          "type": "integer"
                        },
                        "present": {
                          "type": "integer"
                        },
                        "absent": {
                          "type": "integer"
                        },
                        "late": {
                          "type": "integer"
                        },
                        "excused": {
                          "type": "integer"
                        },
                        "percentage": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "by_subject": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "type": "object",
                            "properties": {
                              "due": {
                                "type": "integer"
                              },
                              "marked": {
                                "type": "integer"
                              },
                              "present": {
                                "type": "integer"
                              },
                              "absent": {
                                "type": "integer"
                              },
                              "late": {
                                "type": "integer"
                              },
                              "excused": {
                                "type": "integer"
                              },
                              "percentage": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            }
                          },
                          {
                            "type": "object",
                            "properties": {
                              "subject_id": {
                                "type": "string"
                              },
                              "subject_name": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            }
                          }
                        ]
                      }
                    },
                    "by_month": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "type": "object",
                            "properties": {
                              "due": {
                                "type": "integer"
                              },
                              "marked": {
                                "type": "integer"
                              },
                              "present": {
                                "type": "integer"
                              },
                              "absent": {
                                "type": "integer"
                              },
                              "late": {
                                "type": "integer"
                              },
                              "excused": {
                                "type": "integer"
                              },
                              "percentage": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            }
                          },
                          {
                            "type": "object",
                            "properties": {
                              "month": {
                                "type": "string"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message_key",
          "request_id",
          "field_errors"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "stale_auth",
              "action_denied",
              "object_inaccessible",
              "version_conflict",
              "state_conflict",
              "validation_failed",
              "rate_limited"
            ]
          },
          "message_key": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "field_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "message_key"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message_key": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "AttendanceStatus": {
        "type": "string",
        "enum": [
          "unmarked",
          "present",
          "absent",
          "late",
          "excused"
        ],
        "description": "unmarked means no mark yet; never silently treated as present."
      },
      "WritableStatus": {
        "type": "string",
        "enum": [
          "present",
          "absent",
          "late",
          "excused"
        ]
      },
      "SessionState": {
        "type": "string",
        "enum": [
          "draft",
          "submitted"
        ]
      },
      "RosterSnapshotEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "student_id",
          "enrolment_id",
          "display_name"
        ],
        "properties": {
          "student_id": {
            "type": "string",
            "format": "uuid"
          },
          "enrolment_id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "EntryDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "session_id",
          "enrolment_id",
          "student_id",
          "status",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "enrolment_id": {
            "type": "string",
            "format": "uuid"
          },
          "student_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/AttendanceStatus"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AmendmentDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entry_id",
          "old_status",
          "new_status",
          "reason",
          "actor_id",
          "occurred_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "entry_id": {
            "type": "string",
            "format": "uuid"
          },
          "old_status": {
            "$ref": "#/components/schemas/WritableStatus"
          },
          "new_status": {
            "$ref": "#/components/schemas/WritableStatus"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SessionDTO": {
        "type": "object",
        "additionalProperties": false,
        "description": "Attendance session for one dated timetable period. Timetable and subject fields are server-verified.",
        "required": [
          "id",
          "school_id",
          "timetable_session_id",
          "date",
          "section_id",
          "slot_id",
          "subject_id",
          "timetable_version",
          "roster_version",
          "roster_snapshot",
          "state",
          "version",
          "entries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "school_id": {
            "type": "string",
            "format": "uuid"
          },
          "timetable_session_id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "section_id": {
            "type": "string",
            "format": "uuid"
          },
          "slot_id": {
            "type": "string",
            "format": "uuid"
          },
          "subject_id": {
            "type": "string",
            "format": "uuid"
          },
          "timetable_version": {
            "type": "integer",
            "minimum": 1
          },
          "roster_version": {
            "type": "integer",
            "minimum": 1
          },
          "roster_snapshot": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RosterSnapshotEntry"
            }
          },
          "state": {
            "$ref": "#/components/schemas/SessionState"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntryDTO"
            }
          },
          "submitted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "AuthorizedPeriodDTO": {
        "type": "object",
        "additionalProperties": false,
        "description": "One dated period the current actor may mark, with submission state.",
        "required": [
          "timetable_session_id",
          "date",
          "section_id",
          "slot_id",
          "slot_code",
          "subject_id",
          "assigned_teacher_id",
          "starts_at",
          "ends_at",
          "cancelled",
          "timetable_version",
          "submission_state",
          "missing_count"
        ],
        "properties": {
          "timetable_session_id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "section_id": {
            "type": "string",
            "format": "uuid"
          },
          "slot_id": {
            "type": "string",
            "format": "uuid"
          },
          "slot_code": {
            "type": "string",
            "minLength": 1
          },
          "subject_id": {
            "type": "string",
            "format": "uuid"
          },
          "assigned_teacher_id": {
            "type": "string",
            "format": "uuid"
          },
          "substitute_teacher_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "cancelled": {
            "type": "boolean"
          },
          "timetable_version": {
            "type": "integer",
            "minimum": 1
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "submission_state": {
            "type": "string",
            "enum": [
              "unopened",
              "draft",
              "submitted"
            ]
          },
          "missing_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Roster pupils still unmarked; for unopened equals roster size."
          }
        }
      },
      "PeriodPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthorizedPeriodDTO"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timetable_session_id"
        ],
        "properties": {
          "timetable_session_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SaveEntryInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enrolment_id",
          "status"
        ],
        "properties": {
          "enrolment_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/WritableStatus"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      },
      "SaveSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "entries"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaveEntryInput"
            }
          }
        }
      },
      "SubmitSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CorrectionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reason",
          "expected_version"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/WritableStatus"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CorrectionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "amendment",
          "session_version"
        ],
        "properties": {
          "entry": {
            "$ref": "#/components/schemas/EntryDTO"
          },
          "amendment": {
            "$ref": "#/components/schemas/AmendmentDTO"
          },
          "session_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AttendanceSummaryDTO": {
        "type": "object",
        "additionalProperties": false,
        "description": "Period-based counts. percentage and policy_version are null until a calculation version is configured.",
        "required": [
          "unit",
          "student_id",
          "from_date",
          "to_date",
          "eligible",
          "marked",
          "present",
          "absent",
          "late",
          "excused",
          "unmarked",
          "updated_at"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "const": "period"
          },
          "student_id": {
            "type": "string",
            "format": "uuid"
          },
          "from_date": {
            "type": "string",
            "format": "date"
          },
          "to_date": {
            "type": "string",
            "format": "date"
          },
          "subject_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "eligible": {
            "type": "integer",
            "minimum": 0
          },
          "marked": {
            "type": "integer",
            "minimum": 0
          },
          "present": {
            "type": "integer",
            "minimum": 0
          },
          "absent": {
            "type": "integer",
            "minimum": 0
          },
          "late": {
            "type": "integer",
            "minimum": 0
          },
          "excused": {
            "type": "integer",
            "minimum": 0
          },
          "unmarked": {
            "type": "integer",
            "minimum": 0
          },
          "percentage": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "description": "Decimal string when a calculation version is configured; otherwise null. Never inferred."
          },
          "policy_version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "M04 Teacher Attendance and Corrections \u2014 PROPOSED, NOT FROZEN",
    "version": "0.1.0-proposed",
    "description": "Paths relative to /api/v1. Period/roster/permission validation is server-side. Idempotency-Key required on submit."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],

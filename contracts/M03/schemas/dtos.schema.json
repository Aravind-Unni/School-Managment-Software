    "PeriodTemplateRequest": {
      "type": "object",
      "description": "One bell-time row in a draft grid.",
      "additionalProperties": false,
      "properties": {
        "day_of_week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "ISO-8601 weekday: 1 Monday .. 7 Sunday."
        },
        "slot_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "The school's own short code for a period, e.g. 'P1'. School-authored; this module supplies no period naming convention."
        },
        "starts_at_local": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Wall-clock time at the school (Asia/Kolkata). Never a UTC instant."
        },
        "ends_at_local": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Wall-clock time at the school (Asia/Kolkata). Never a UTC instant."
        }
      },
      "required": [
        "day_of_week",
        "slot_code",
        "starts_at_local",
        "ends_at_local"
      ]
    },
    "SlotRequest": {
      "type": "object",
      "description": "One cell in a draft grid. The period is named by weekday and slot code, not by id, so a grid can be sent before its period rows have ids.",
      "additionalProperties": false,
      "properties": {
        "day_of_week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "ISO-8601 weekday: 1 Monday .. 7 Sunday."
        },
        "slot_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,

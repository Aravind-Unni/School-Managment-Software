          "type": "string",
          "format": "uuid"
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "teacher_id": {
          "type": "string",
          "format": "uuid"
        },
        "room_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        }
      },
      "required": [
        "day_of_week",
        "slot_code",
        "section_id",
        "subject_id",
        "teacher_id"
      ]
    },
    "CreateTimetableRequest": {
      "type": "object",
      "description": "Create a draft revision. Never creates a published one: publication is a separate, authorised transition.",

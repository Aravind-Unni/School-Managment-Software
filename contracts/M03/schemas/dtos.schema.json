{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school/M03/dtos-proposed",
  "title": "M03 timetable DTOs \u2014 PROPOSED, NOT FROZEN",
  "description": "Every request object is CLOSED: an unknown field is a 422, never silently ignored. Every response carries the school_id and, for a mutable aggregate, an integer version. Dates are civil dates at the school (Asia/Kolkata); instants are UTC.",
  "$defs": {
    "ErrorEnvelope": {
      "type": "object",
      "description": "The frozen error body. M03 adds no field to it; only message_key values are module-specific.",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "unauthenticated",
            "stale_auth",
            "action_denied",
            "object_inaccessible",
            "version_conflict",
            "state_conflict",
            "validation_failed",
            "rate_limited"
          ]
        },
        "message_key": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "field_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One field-scoped validation problem.",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "message_key": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "field",
              "message_key"
            ]
          }
        }
      },
      "required": [
        "code",
        "message_key",
        "request_id",
        "field_errors"
      ]
    },
    "PeriodTemplateDTO": {
      "type": "object",
      "description": "One bell-time slot on one weekday, owned by a timetable version. Bell times can change between revisions, so the template belongs to the version rather than to the school.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "school_id": {
          "type": "string",
          "format": "uuid"
        },
        "timetable_id": {
          "type": "string",
          "format": "uuid"
        },
        "day_of_week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "ISO-8601 weekday: 1 Monday .. 7 Sunday."
        },
        "slot_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "The school's own short code for a period, e.g. 'P1'. School-authored; this module supplies no period naming convention."
        },
        "starts_at_local": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Wall-clock time at the school (Asia/Kolkata). Never a UTC instant."
        },
        "ends_at_local": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Wall-clock time at the school (Asia/Kolkata). Never a UTC instant."
        }
      },
      "required": [
        "id",
        "school_id",
        "timetable_id",
        "day_of_week",
        "slot_code",
        "starts_at_local",
        "ends_at_local"
      ]
    },
    "SlotDTO": {
      "type": "object",
      "description": "One recurring teaching assignment: this section takes this subject from this teacher in this period, every week the version is effective.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "school_id": {
          "type": "string",
          "format": "uuid"
        },
        "timetable_id": {
          "type": "string",
          "format": "uuid"
        },
        "period_template_id": {
          "type": "string",
          "format": "uuid"
        },
        "day_of_week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "ISO-8601 weekday: 1 Monday .. 7 Sunday."
        },
        "slot_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "The school's own short code for a period, e.g. 'P1'. School-authored; this module supplies no period naming convention."
        },
        "section_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "teacher_id": {
          "type": "string",
          "format": "uuid"
        },
        "room_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32,
          "description": "PROPOSED. Free text, school-authored. There is no Room aggregate and no room conflict detection: rooms were not among the owned records, so modelling them would widen the module."
        }
      },
      "required": [
        "id",
        "school_id",
        "timetable_id",
        "period_template_id",
        "day_of_week",
        "slot_code",
        "section_id",
        "subject_id",
        "teacher_id",
        "room_code"
      ]
    },
    "TimetableVersionDTO": {
      "type": "object",
      "description": "One dated revision of the central timetable. Periods and slots are its children and are replaced as a whole while it is a draft.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "school_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "year_id": {
          "type": "string",
          "format": "uuid"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "superseded"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "periods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PeriodTemplateDTO"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotDTO"
          }
        }
      },
      "required": [
        "id",
        "school_id",
        "version",
        "year_id",
        "effective_from",
        "effective_to",
        "state",
        "published_at",
        "periods",
        "slots"
      ]
    },
    "TimetableSummaryDTO": {
      "type": "object",
      "description": "A timetable version without its grid, for listing.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "school_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "year_id": {
          "type": "string",
          "format": "uuid"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "superseded"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "period_count": {
          "type": "integer",
          "minimum": 0
        },
        "slot_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "school_id",
        "version",
        "year_id",
        "effective_from",
        "effective_to",
        "state",
        "published_at",
        "period_count",
        "slot_count"
      ]
    },
    "ConflictDTO": {
      "type": "object",
      "description": "One detected conflict. 'blocking' true means publish refuses while it stands.",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "teacher_double_booked",
            "section_double_booked",
            "teacher_unavailable",
            "teacher_not_assigned",
            "period_overlap",
            "slot_references_unknown_period",
            "section_unknown_to_registry"
          ]
        },
        "message_key": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "slot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "teacher_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "required": [
        "code",
        "message_key",
        "blocking",
        "slot_ids",
        "teacher_id",
        "section_id",
        "date"
      ]
    },
    "ValidationReportDTO": {
      "type": "object",
      "description": "The result of validating a draft. An empty list means publish would be accepted at this moment; it is not a reservation.",
      "additionalProperties": false,
      "properties": {
        "timetable_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConflictDTO"
          }
        }
      },
      "required": [
        "timetable_id",
        "version",
        "conflicts"
      ]
    },
    "PublishResultDTO": {
      "type": "object",
      "description": "The outcome of publishing a draft.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "school_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "const": "published"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "superseded_timetable_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "school_id",
        "version",
        "state",
        "effective_from",
        "effective_to",
        "superseded_timetable_id"
      ]
    },
    "PeriodSessionDTO": {
      "type": "object",
      "description": "One dated teaching period. Its identity is stable across timetable revisions, so attendance written against it reconciles after a republish.",
      "additionalProperties": false,
      "properties": {
        "timetable_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "school_id": {
          "type": "string",
          "format": "uuid"
        },
        "section_id": {
          "type": "string",
          "format": "uuid"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "slot_id": {
          "type": "string",
          "format": "uuid"
        },
        "slot_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "The school's own short code for a period, e.g. 'P1'. School-authored; this module supplies no period naming convention."
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "assigned_teacher_id": {
          "type": "string",
          "format": "uuid"
        },
        "substitute_teacher_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "starts_at_local": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Wall-clock time at the school (Asia/Kolkata). Never a UTC instant."
        },
        "ends_at_local": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Wall-clock time at the school (Asia/Kolkata). Never a UTC instant."
        },
        "cancelled": {
          "type": "boolean"
        },
        "cancellation_reason_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable message key the frontend renders in English or Malayalam. Never user-facing prose."
        },
        "room_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "timetable_id": {
          "type": "string",
          "format": "uuid"
        },
        "timetable_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Aggregate version of the timetable that produced this session. Paired with timetable_id so a consumer can name the exact revision."
        }
      },
      "required": [
        "timetable_session_id",
        "school_id",
        "section_id",
        "date",
        "slot_id",
        "slot_code",
        "subject_id",
        "assigned_teacher_id",
        "substitute_teacher_id",
        "starts_at",
        "ends_at",
        "starts_at_local",
        "ends_at_local",
        "cancelled",
        "cancellation_reason_key",
        "room_code",
        "timetable_id",
        "timetable_version"
      ]
    },
    "SectionDayDTO": {
      "type": "object",
      "description": "The effective schedule for one section on one date, with the calendar answer that produced it.",
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "type": "string",
          "format": "uuid"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "is_school_day": {
          "type": "boolean"
        },
        "reason_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable message key the frontend renders in English or Malayalam. Never user-facing prose."
        },
        "timetable_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "timetable_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PeriodSessionDTO"
          }
        }
      },
      "required": [
        "section_id",
        "date",
        "is_school_day",
        "reason_key",
        "timetable_id",
        "timetable_version",
        "sessions"
      ]
    },
    "TeacherDayDTO": {
      "type": "object",
      "description": "One teacher's dated schedule: periods they are assigned to, plus periods they are substituting on that date.",
      "additionalProperties": false,
      "properties": {
        "staff_id": {
          "type": "string",
          "format": "uuid"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "is_school_day": {
          "type": "boolean"
        },
        "reason_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable message key the frontend renders in English or Malayalam. Never user-facing prose."
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PeriodSessionDTO"
          }
        }
      },
      "required": [
        "staff_id",
        "date",
        "is_school_day",
        "reason_key",
        "sessions"
      ]
    },
    "StudentSessionDTO": {
      "type": "object",
      "description": "One session as a pupil sees it. 'enrolled' comes from the subject-filtered roster, so a pupil who does not take the subject sees a free period rather than a lesson they must attend.",
      "additionalProperties": false,
      "properties": {
        "session": {
          "$ref": "#/$defs/PeriodSessionDTO"
        },
        "enrolled": {
          "type": "boolean"
        }
      },
      "required": [
        "session",
        "enrolled"
      ]
    },
    "StudentDayDTO": {
      "type": "object",
      "description": "One pupil's dated schedule, resolved through their section.",
      "additionalProperties": false,
      "properties": {
        "student_id": {
          "type": "string",
          "format": "uuid"
        },
        "section_id": {
          "type": "string",
          "format": "uuid"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "is_school_day": {
          "type": "boolean"
        },
        "reason_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable message key the frontend renders in English or Malayalam. Never user-facing prose."
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StudentSessionDTO"
          }
        }
      },
      "required": [
        "student_id",
        "section_id",
        "date",
        "is_school_day",
        "reason_key",
        "sessions"
      ]
    },
    "CalendarDayDTO": {
      "type": "object",
      "description": "Whether one date is a teaching day, and why not when it is not.",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "is_school_day": {
          "type": "boolean"
        },
        "reason_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable message key the frontend renders in English or Malayalam. Never user-facing prose."
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "holiday",
              "exam",
              "event"
            ]
          },
          "description": "Every exception in force on the date. An exam day is a teaching day; a holiday is not."
        }
      },
      "required": [
        "date",
        "is_school_day",
        "reason_key",
        "kinds"
      ]
    },
    "CalendarDTO": {
      "type": "object",
      "description": "A dated range of calendar answers.",
      "additionalProperties": false,
      "properties": {
        "from_date": {
          "type": "string",
          "format": "date"
        },
        "to_date": {
          "type": "string",
          "format": "date"
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CalendarDayDTO"
          }
        }
      },
      "required": [
        "from_date",
        "to_date",
        "days"
      ]
    },
    "CalendarExceptionDTO": {
      "type": "object",
      "description": "One school-authored exception to the weekly pattern.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "school_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "kind": {
          "type": "string",
          "enum": [
            "holiday",
            "exam",
            "event"
          ]
        },
        "reason_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable message key the frontend renders in English or Malayalam. Never user-facing prose."
        },
        "withdrawn": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "school_id",
        "version",
        "date",
        "kind",
        "reason_key",
        "withdrawn"
      ]
    },
    "TeacherUnavailableDTO": {
      "type": "object",
      "description": "A half-open UTC interval during which a staff member cannot teach.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "school_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "staff_id": {
          "type": "string",
          "format": "uuid"
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable message key the frontend renders in English or Malayalam. Never user-facing prose."
        },
        "withdrawn": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "school_id",
        "version",
        "staff_id",
        "starts_at",
        "ends_at",
        "reason_key",
        "withdrawn"
      ]
    },
    "SubstitutionDTO": {
      "type": "object",
      "description": "An explicit dated replacement for one period. It authorises the substitute for that session only, until valid_until.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "school_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "slot_id": {
          "type": "string",
          "format": "uuid"
        },
        "timetable_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "section_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "original_teacher_id": {
          "type": "string",
          "format": "uuid"
        },
        "substitute_teacher_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "withdrawn": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "school_id",
        "version",
        "date",
        "slot_id",
        "timetable_session_id",
        "section_id",
        "subject_id",
        "original_teacher_id",
        "substitute_teacher_id",
        "reason",
        "valid_until",
        "withdrawn"
      ]
    },

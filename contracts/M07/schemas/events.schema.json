{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school/M07/events",
  "title": "M07 fees event payloads",
  "description": "Payloads only. Envelope is frozen common. Proposed names use dotted snake form.",
  "$defs": {
    "fees.payment_posted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payment_id", "student_id", "receipt_number"],
      "properties": {
        "payment_id": { "type": "string", "format": "uuid" },
        "student_id": { "type": "string", "format": "uuid" },
        "receipt_number": { "type": "string", "minLength": 1 }
      }
    },
    "fees.payment_reversed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payment_id", "reversal_id"],
      "properties": {
        "payment_id": { "type": "string", "format": "uuid" },
        "reversal_id": { "type": "string", "format": "uuid" }
      }
    },
    "fees.charge_posted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["charge_id", "student_id", "source_key"],
      "properties": {
        "charge_id": { "type": "string", "format": "uuid" },
        "student_id": { "type": "string", "format": "uuid" },
        "source_key": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "status": "proposed",
  "note": "Reuses frozen ErrorCode values; message_key values are module-owned.",
  "rows": [
    {
      "status": 401,
      "code": "unauthenticated",
      "message_key": "error.unauthenticated",
      "when": "No server-derived session."
    },
    {
      "status": 401,
      "code": "stale_auth",
      "message_key": "error.two_factor_required",
      "when": "Reversal/refund/major concession without ever asserting 2FA."
    },
    {
      "status": 401,
      "code": "stale_auth",
      "message_key": "error.two_factor_stale",
      "when": "Reversal/refund/major concession with 2FA older than 300s."
    },
    {
      "status": 403,
      "code": "action_denied",
      "message_key": "error.action_denied",
      "when": "Actor lacks fees.* permission for the requested write/read."
    },
    {
      "status": 404,
      "code": "object_inaccessible",
      "message_key": "error.object_inaccessible",
      "when": "Absent or other-school charge/payment/plan/student. Cross-school always 404. Unrelated guardian on foreign child."
    },
    {
      "status": 409,
      "code": "version_conflict",
      "message_key": "error.version_conflict",
      "when": "expected_version mismatch on reversal or mutable aggregate update."
    },
    {
      "status": 409,
      "code": "state_conflict",
      "message_key": "fees.error.source_key_conflict",
      "when": "source_key reused with a different charge payload."
    },
    {
      "status": 409,
      "code": "state_conflict",
      "message_key": "fees.error.idempotency_payload_conflict",
      "when": "Idempotency-Key reused with a different payment payload."
    },
    {
      "status": 409,
      "code": "state_conflict",
      "message_key": "fees.error.already_reversed",
      "when": "Reversal requested for a payment that is already fully reversed."
    },
    {
      "status": 409,
      "code": "state_conflict",
      "message_key": "fees.error.allocation_exceeds_available",
      "when": "Concurrent or sequential allocation would exceed payment remainder or charge balance."
    },
    {
      "status": 422,
      "code": "validation_failed",
      "message_key": "error.validation_failed",
      "when": "Malformed body or unknown field (closed schemas)."
    },
    {
      "status": 422,
      "code": "validation_failed",
      "message_key": "error.server_internal_field_rejected",
      "when": "Body carried school_id/actor_id/auth_level/grant."
    },
    {
      "status": 422,
      "code": "validation_failed",
      "message_key": "fees.error.amount_not_positive",
      "when": "amount_paise <= 0 on charge, payment, credit, allocation or refund."
    },
    {
      "status": 422,
      "code": "validation_failed",
      "message_key": "fees.error.idempotency_key_required",
      "when": "POST /payments without Idempotency-Key header."
    },
    {
      "status": 422,
      "code": "validation_failed",
      "message_key": "fees.error.reason_required",
      "when": "Reversal, refund or concession missing non-empty reason."
    },
    {
      "status": 422,
      "code": "validation_failed",
      "message_key": "fees.error.invalid_method",
      "when": "Payment method not in cash|bank|upi."
    },
    {
      "status": 422,
      "code": "validation_failed",
      "message_key": "fees.error.allocation_mismatch",
      "when": "Allocations sum exceeds payment amount_paise or references foreign charges."
    }
  ]
}

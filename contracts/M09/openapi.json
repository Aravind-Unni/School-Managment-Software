{
  "openapi": "3.1.0",
  "info": {
    "title": "M09 Library Catalogue Lending and Returns",
    "version": "1.0.0",
    "description": "Paths relative to /api/v1. Titles, copies, loans, renewals, overdues, catalogue import. No fines. Closed write schemas."
  },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "session": [] }],
  "paths": {
    "/library/titles": {
      "post": {
        "operationId": "create_library_title",
        "summary": "Create a catalogue title",
        "x-permission": "library.catalogue.manage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTitleRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TitleDTO" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      },
      "get": {
        "operationId": "search_library_titles",
        "summary": "Search titles (Unicode name/author)",
        "x-permission": "library.read_own",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TitleCollection" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/library/titles/{id}/availability": {
      "get": {
        "operationId": "get_title_availability",
        "summary": "Available and total copy counts",
        "x-permission": "library.read_own",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AvailabilityView" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/library/copies": {
      "post": {
        "operationId": "create_library_copy",
        "summary": "Register a physical copy",
        "x-permission": "library.catalogue.manage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCopyRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CopyDTO" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/library/copies/{id}/adjust": {
      "post": {
        "operationId": "adjust_library_copy",
        "summary": "Lost/damaged/withdrawn adjustment with reason",
        "x-permission": "library.catalogue.manage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdjustCopyRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Adjusted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CopyAdjustmentDTO" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/library/loans": {
      "post": {
        "operationId": "issue_library_loan",
        "summary": "Issue a copy to a borrower",
        "x-permission": "library.issue",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateLoanRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Issued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoanDTO" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/library/loans/{id}/return": {
      "post": {
        "operationId": "return_library_loan",
        "summary": "Return a loan (retry-safe)",
        "x-permission": "library.return",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReturnLoanRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Closed loan",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoanDTO" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/library/loans/{id}/renew": {
      "post": {
        "operationId": "renew_library_loan",
        "summary": "Renew an open loan",
        "x-permission": "library.renew",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RenewLoanRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Renewed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoanDTO" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/library/borrowers/{person_id}/loans": {
      "get": {
        "operationId": "list_borrower_loans",
        "summary": "Borrower loan history (own or librarian)",
        "x-permission": "library.read_own",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoanCollection" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/library/overdues": {
      "get": {
        "operationId": "list_library_overdues",
        "summary": "Overdue open loans as of a school civil date",
        "x-permission": "library.read_overdues",
        "parameters": [
          {
            "name": "as_of",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OverdueCollection" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/library/catalogue-imports": {
      "post": {
        "operationId": "import_library_catalogue",
        "summary": "Import titles/copies with duplicate review",
        "x-permission": "library.catalogue.manage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CatalogueImportRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created rows plus review items",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CatalogueImportResult" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    },
    "responses": {
      "Error": {
        "description": "Frozen error envelope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message_key", "field_errors", "request_id"],
        "properties": {
          "code": { "type": "string" },
          "message_key": { "type": "string" },
          "field_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "message_key"],
              "properties": {
                "field": { "type": "string" },
                "message_key": { "type": "string" }
              }
            }
          },
          "request_id": { "type": "string", "format": "uuid" }
        }
      },
      "CopyState": {
        "type": "string",
        "enum": ["available", "on_loan", "lost", "damaged", "withdrawn"]
      },
      "BorrowerType": {
        "type": "string",
        "enum": ["student", "staff"]
      },
      "ReturnCondition": {
        "type": "string",
        "enum": ["ok", "damaged", "lost"]
      },
      "TitleDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "school_id", "name", "author", "language", "version"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "school_id": { "type": "string", "format": "uuid" },
          "isbn": { "type": ["string", "null"] },
          "name": { "type": "string" },
          "author": { "type": "string" },
          "language": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 }
        }
      },
      "CreateTitleRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "author", "language"],
        "properties": {
          "isbn": { "type": ["string", "null"] },
          "name": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 }
        }
      },
      "CopyDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "school_id",
          "title_id",
          "accession_no",
          "state",
          "version"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "school_id": { "type": "string", "format": "uuid" },
          "title_id": { "type": "string", "format": "uuid" },
          "accession_no": { "type": "string" },
          "state": { "$ref": "#/components/schemas/CopyState" },
          "version": { "type": "integer", "minimum": 1 }
        }
      },
      "CreateCopyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title_id", "accession_no"],
        "properties": {
          "title_id": { "type": "string", "format": "uuid" },
          "accession_no": { "type": "string", "minLength": 1 }
        }
      },
      "LoanDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "school_id",
          "copy_id",
          "borrower_person_id",
          "borrower_type",
          "issued_at",
          "due_date",
          "version"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "school_id": { "type": "string", "format": "uuid" },
          "copy_id": { "type": "string", "format": "uuid" },
          "borrower_person_id": { "type": "string", "format": "uuid" },
          "borrower_type": { "$ref": "#/components/schemas/BorrowerType" },
          "issued_at": { "type": "string", "format": "date-time" },
          "due_date": { "type": "string", "format": "date" },
          "returned_at": { "type": ["string", "null"], "format": "date-time" },
          "version": { "type": "integer", "minimum": 1 }
        }
      },
      "CreateLoanRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "copy_id",
          "borrower_person_id",
          "borrower_type",
          "due_date"
        ],
        "properties": {
          "copy_id": { "type": "string", "format": "uuid" },
          "borrower_person_id": { "type": "string", "format": "uuid" },
          "borrower_type": { "$ref": "#/components/schemas/BorrowerType" },
          "due_date": { "type": "string", "format": "date" }
        }
      },
      "ReturnLoanRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["returned_at", "condition", "expected_version"],
        "properties": {
          "returned_at": { "type": "string", "format": "date-time" },
          "condition": { "$ref": "#/components/schemas/ReturnCondition" },
          "expected_version": { "type": "integer", "minimum": 1 }
        }
      },
      "RenewLoanRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["new_due_date", "expected_version"],
        "properties": {
          "new_due_date": { "type": "string", "format": "date" },
          "expected_version": { "type": "integer", "minimum": 1 },
          "reason": { "type": ["string", "null"] }
        }
      },
      "CopyAdjustmentDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "school_id",
          "copy_id",
          "reason",
          "old_state",
          "new_state",
          "actor_id"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "school_id": { "type": "string", "format": "uuid" },
          "copy_id": { "type": "string", "format": "uuid" },
          "reason": { "type": "string" },
          "old_state": { "$ref": "#/components/schemas/CopyState" },
          "new_state": { "$ref": "#/components/schemas/CopyState" },
          "actor_id": { "type": "string", "format": "uuid" }
        }
      },
      "AdjustCopyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["new_state", "reason", "expected_version"],
        "properties": {
          "new_state": { "$ref": "#/components/schemas/CopyState" },
          "reason": { "type": "string", "minLength": 1 },
          "expected_version": { "type": "integer", "minimum": 1 }
        }
      },
      "AvailabilityView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["available", "total"],
        "properties": {
          "available": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 }
        }
      },
      "OverdueItemDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "loan_id",
          "copy_id",
          "accession_no",
          "borrower_person_id",
          "borrower_display_name",
          "due_date",
          "as_of"
        ],
        "properties": {
          "loan_id": { "type": "string", "format": "uuid" },
          "copy_id": { "type": "string", "format": "uuid" },
          "accession_no": { "type": "string" },
          "borrower_person_id": { "type": "string", "format": "uuid" },
          "borrower_display_name": { "type": "string" },
          "due_date": { "type": "string", "format": "date" },
          "as_of": { "type": "string", "format": "date" }
        }
      },
      "CatalogueImportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rows"],
        "properties": {
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "author", "language", "accession_no"],
              "properties": {
                "isbn": { "type": ["string", "null"] },
                "name": { "type": "string", "minLength": 1 },
                "author": { "type": "string", "minLength": 1 },
                "language": { "type": "string", "minLength": 1 },
                "accession_no": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      },
      "CatalogueImportResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["created_title_ids", "created_copy_ids", "review_items"],
        "properties": {
          "created_title_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "created_copy_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "review_items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["row_index", "issue", "accession_no"],
              "properties": {
                "row_index": { "type": "integer", "minimum": 0 },
                "issue": {
                  "type": "string",
                  "enum": ["duplicate_accession", "duplicate_isbn_review"]
                },
                "accession_no": { "type": "string" },
                "isbn": { "type": ["string", "null"] }
              }
            }
          }
        }
      },
      "TitleCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "next_cursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TitleDTO" }
          },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "LoanCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "next_cursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LoanDTO" }
          },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "OverdueCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "next_cursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OverdueItemDTO" }
          },
          "next_cursor": { "type": ["string", "null"] }
        }
      }
    }
  }
}

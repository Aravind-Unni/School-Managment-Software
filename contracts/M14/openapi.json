{
  "openapi": "3.1.0",
  "info": {
    "title": "M14 Platform — audit, jobs, backup, observability",
    "version": "1.0.0",
    "description": "Paths relative to /api/v1. Real audit/outbox/jobs/backup. Closed write schemas. Foundation /healthz and /readyz remain for container probes."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "health_live",
        "summary": "Minimal public liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealthDTO"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready",
        "summary": "Authenticated readiness for database, queue and file processor",
        "x-permission": "platform.read_health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyHealthDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "description": "One or more checks failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyHealthDTO"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "operationId": "get_job",
        "summary": "Scoped job progress/state and sanitized error",
        "x-permission": "jobs.read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{id}/retry": {
      "post": {
        "operationId": "retry_job",
        "summary": "Authorized replay preserving business idempotency",
        "x-permission": "jobs.retry",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetryJobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted for replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/audit": {
      "get": {
        "operationId": "list_audit",
        "summary": "Read-only scoped audit records",
        "x-permission": "audit.read",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "actor_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "aggregate_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "occurred_from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "occurred_to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditCollection"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/operations/restore-rehearsals": {
      "post": {
        "operationId": "create_restore_rehearsal",
        "summary": "Operator-only isolated restore rehearsal",
        "x-permission": "backups.manage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRestoreRehearsalRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestoreRehearsalDTO"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    },
    "responses": {
      "Error": {
        "description": "Stable error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message_key",
          "field_errors",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message_key": {
            "type": "string"
          },
          "field_errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "LiveHealthDTO": {
        "$ref": "schemas/dtos.schema.json#/$defs/LiveHealthDTO"
      },
      "ReadyHealthDTO": {
        "$ref": "schemas/dtos.schema.json#/$defs/ReadyHealthDTO"
      },
      "JobDTO": {
        "$ref": "schemas/dtos.schema.json#/$defs/JobDTO"
      },
      "RetryJobRequest": {
        "$ref": "schemas/dtos.schema.json#/$defs/RetryJobRequest"
      },
      "AuditRecordDTO": {
        "$ref": "schemas/dtos.schema.json#/$defs/AuditRecordDTO"
      },
      "AuditCollection": {
        "$ref": "schemas/dtos.schema.json#/$defs/AuditCollection"
      },
      "CreateRestoreRehearsalRequest": {
        "$ref": "schemas/dtos.schema.json#/$defs/CreateRestoreRehearsalRequest"
      },
      "RestoreRehearsalDTO": {
        "$ref": "schemas/dtos.schema.json#/$defs/RestoreRehearsalDTO"
      }
    }
  }
}

{
  "status": "proposed",
  "note": "Reuses frozen ErrorCode values; message_key values are module-owned.",
  "rows": [
    {
      "status": 401,
      "code": "unauthenticated",
      "message_key": "error.unauthenticated",
      "when": "No server-derived session."
    },
    {
      "status": 403,
      "code": "action_denied",
      "message_key": "error.action_denied",
      "when": "Actor lacks platform.read_health / jobs.read / jobs.retry / audit.read / backups.manage."
    },
    {
      "status": 403,
      "code": "action_denied",
      "message_key": "platform.error.ops_identity_required",
      "when": "Restore rehearsal called by a school-created role rather than company-ops identity."
    },
    {
      "status": 403,
      "code": "auth_step_up_required",
      "message_key": "error.auth_step_up_required",
      "when": "backups.manage requires recent 2FA and fixture says stale."
    },
    {
      "status": 404,
      "code": "object_inaccessible",
      "message_key": "error.object_inaccessible",
      "when": "Absent or other-school job, audit row, or backup manifest. Cross-school always 404."
    },
    {
      "status": 409,
      "code": "version_conflict",
      "message_key": "error.version_conflict",
      "when": "expected_version mismatch on mutable Job."
    },
    {
      "status": 409,
      "code": "state_conflict",
      "message_key": "platform.error.job_not_retryable",
      "when": "Retry requested for queued, running, or succeeded job."
    },
    {
      "status": 409,
      "code": "state_conflict",
      "message_key": "platform.error.production_target_forbidden",
      "when": "Restore rehearsal isolated_target_label names production."
    },
    {
      "status": 422,
      "code": "validation_failed",
      "message_key": "error.validation_failed",
      "when": "Malformed body or unknown write field."
    },
    {
      "status": 422,
      "code": "validation_failed",
      "message_key": "error.server_internal_field_rejected",
      "when": "Body carried school_id, actor_id, or resource_grant."
    },
    {
      "status": 422,
      "code": "validation_failed",
      "message_key": "platform.error.unknown_job_kind",
      "when": "start_job/enqueue kind not in allowlist for this deployment."
    }
  ]
}

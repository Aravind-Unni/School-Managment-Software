{
  "openapi": "3.1.0",
  "info": {
    "title": "M05 Assessments, Grades and Published Answer Sheets",
    "version": "1.0.0",
    "description": "Paths relative to /api/v1. Closed write schemas. Publication requires Idempotency-Key and recent 2FA. Draft results never returned to student/guardian scopes."
  },

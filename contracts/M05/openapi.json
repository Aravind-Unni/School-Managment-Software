  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message_key",
          "request_id",
          "field_errors"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "stale_auth",
              "action_denied",
              "object_inaccessible",
              "version_conflict",
              "state_conflict",
              "validation_failed",
              "rate_limited"
            ]
          },
          "message_key": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "field_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "message_key"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message_key": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "MarkDecimal": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
        "description": "Non-negative decimal-string, max 2 places. Range vs max_score is module-validated."
      },
      "AssessmentType": {
        "type": "string",
        "enum": [
          "assignment",
          "written_test",
          "practical",
          "project"
        ]
      },
      "AssessmentState": {
        "type": "string",
        "enum": [
          "draft",
          "submitted",
          "approved",
          "published",
          "reopened"
        ]
      },
      "ResultWorkflowStatus": {
        "type": "string",
        "enum": [
          "draft",
          "submitted",
          "approved",
          "published",
          "reopened"
        ]
      },
      "MarkingOutcome": {
        "type": "string",
        "enum": [
          "scored",
          "absent",
          "exempt",
          "oral",
          "practical"
        ],
        "description": "absent/exempt are distinct from score 0.00"
      },
      "ComponentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "max_score",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional client id; server may assign"
          },
          "max_score": {
            "$ref": "#/$defs/MarkDecimal"
          },
          "weight": {
            "type": "string",
            "pattern": "^(0|1|0\\.[0-9]{1,3}|1\\.0{1,3})$",
            "description": "Decimal-string weight; components must sum to 1.000"
          },
          "topic": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "question_type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          }
        }
      },
      "ComponentDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "max_score",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "max_score": {
            "$ref": "#/$defs/MarkDecimal"
          },
          "weight": {
            "type": "string"
          },
          "topic": {
            "type": [
              "string",
              "null"
            ]
          },
          "question_type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateAssessmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year_id",
          "term_id",
          "section_id",
          "subject_id",
          "type",
          "components",
          "policy_version"
        ],
        "properties": {
          "year_id": {
            "type": "string",
            "format": "uuid"
          },
          "term_id": {
            "type": "string",
            "format": "uuid"
          },
          "section_id": {
            "type": "string",
            "format": "uuid"
          },
          "subject_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/$defs/AssessmentType"
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/ComponentInput"
            }
          },
          "policy_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Required when type=assignment"
          },
          "max_score": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional override; default sum of component max_score"
          }
        }
      },
      "AssessmentDTO": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "school_id",
          "version",
          "year_id",
          "term_id",
          "section_id",
          "subject_id",
          "type",
          "max_score",
          "policy_version",
          "state",
          "components"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "school_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "year_id": {
            "type": "string",
            "format": "uuid"
          },
          "term_id": {
            "type": "string",
            "format": "uuid"
          },
          "section_id": {
            "type": "string",
            "format": "uuid"
          },
          "subject_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/$defs/AssessmentType"
          },
          "max_score": {
            "$ref": "#/$defs/MarkDecimal"
          },
          "policy_version": {
            "type": "string"
          },
          "state": {
            "$ref": "#/$defs/AssessmentState"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ComponentDTO"
            }
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ComponentScoreInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "score"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "format": "uuid"
          },
          "score": {
            "$ref": "#/$defs/MarkDecimal"
          }
        }
      },
      "PatchResultRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "attempt_id",
          "status"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1
